spring.application.name=vitacare-api
server.port=8080

# Base de datos (MySQL 8, no MariaDB)
spring.datasource.url=jdbc:mysql://localhost:3306/vitacare_db?allowPublicKeyRetrieval=true&useSSL=false
spring.datasource.username=TU_USUARIO
spring.datasource.password=TU_PASSWORD

spring.jpa.open-in-view=false
spring.jpa.hibernate.ddl-auto=validate
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration

# JWT: mínimo 32 caracteres
jwt.secreto=CAMBIA_ESTO_POR_UN_SECRETO_LARGO_DE_32_CARACTERES_O_MAS

# CORS: URL(s) del frontend separadas por coma
cors.origenes-permitidos=http://localhost:5173